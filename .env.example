# ── Banco de dados PostgreSQL (Neon / Vercel Postgres) ──
# Na Vercel, ao conectar o storage Postgres, esta variável é criada automaticamente
# (DATABASE_URL ou POSTGRES_URL). O código aceita qualquer uma das duas.
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

